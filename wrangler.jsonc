{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "discord-break-reminder",
	"main": "src/index.js",
	"compatibility_date": "2026-07-13",
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"vars": {
		"WEBHOOK_NAME": "쉬는시간 알리미"
	},
	"kv_namespaces": [
		{
			"binding": "SCHEDULE_KV",
			"id": "861a97f048d74b91a54345b32213e2fd"
		}
	]
}